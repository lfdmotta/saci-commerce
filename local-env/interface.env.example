# Copie para saci-interface/.env para a interface usar o back-end local
# (servidor de desenvolvimento do saci-commerce: `task dev` ou
# `cargo run -p saci-commerce-dev`).

# Liga as APIs reais (todas: o servidor local também atende /v1/identity e /v1/payments com o sandbox).
EXPO_PUBLIC_USE_MOCKS=false

# API geral, pagamentos (host pay.) e layouts: tudo no mesmo servidor local.
EXPO_PUBLIC_API_URL=http://localhost:8787
EXPO_PUBLIC_PAY_URL=http://localhost:8787
EXPO_PUBLIC_LAYOUT_MOCK=false
EXPO_PUBLIC_LAYOUT_BASE_URL=http://localhost:8787/layouts

# As fotos e fontes das sementes vêm do Unsplash e do Fontsource (as mesmas dos
# mocks); só fora de produção.
EXPO_PUBLIC_TRUSTED_HOSTS=images.unsplash.com,cdn.jsdelivr.net

# App no celular (Expo Go) na mesma rede: troque localhost pelo IP da máquina
# aqui e suba o servidor com SACI_DEV_BIND=0.0.0.0 SACI_DEV_PUBLIC_URL=http://<ip>:8787
