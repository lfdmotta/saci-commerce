# Estado no S3 do LocalStack (criado por saci-boiuna/local-env/scripts/bootstrap.sh).
bucket                      = "saci-tfstate-local"
key                         = "services/customers/terraform.tfstate"
region                      = "sa-east-1"
use_lockfile                = true
use_path_style              = true
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
endpoints = {
  s3 = "http://localhost.localstack.cloud:4566"
}
